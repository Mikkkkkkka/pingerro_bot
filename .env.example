TELEGRAM_BOT_TOKEN=your_token_here
# Optional. SQLite is used by default.
# PING_BOT_DATABASE_PATH=data/ping_bot.sqlite3
# To use PostgreSQL instead, set a standard connection URL:
# PING_BOT_DATABASE_URL=postgresql://username:password@localhost:5432/ping_bot
# Optional. Time in seconds between /all calls in the same group.
# PING_BOT_COOLDOWN_SECONDS=300
